# =============================================================================
# NFM-DB V2 parity baseline cron (NFM-2946 / ADR-0007 §3 staging gate)
# =============================================================================
# >>>>> STAGING-HOST INSTALLATION REQUIRED <<<<<
#
# The PARITY_REPO_DIR / PARITY_PYTHON / cron-command paths below are
# **dev-machine defaults** (LE author's macOS). They DO NOT exist on a
# Linux staging host. You MUST edit the four `PARITY_*` lines below AND
# the cron line at the bottom before `sudo install`-ing this file into
# /etc/cron.d/. See docs/deployment/parity-staging-cron.md for the
# full install runbook.
#
# Quick reference values for a typical Linux staging host:
#   PARITY_REPO_DIR   -> /srv/nucpot                            (path to checkout)
#   PARITY_PYTHON     -> /srv/nucpot/apps/api/.venv/bin/python
#   PARITY_ARTIFACTS  -> /var/log/nucpot/parity                 (default OK; ensure writable)
#   cron-line script  -> /srv/nucpot/scripts/run-parity-cron.sh
# =============================================================================
#
# Full install paths:
#   Linux:
#     sudo install -o root -g root -m 0644 \
#         scripts/cron/parity-staging-cron.d/nucpot-parity \
#         /etc/cron.d/nucpot-parity
#     sudo systemctl restart cron
#
#   macOS (per-user crontab; see docs/deployment/parity-staging-cron.md):
#     crontab scripts/cron/parity-staging-cron.d/nucpot-parity
#
# Schedule: 02:00 UTC nightly. The runner archives per-fixture results
# under $PARITY_ARTIFACTS with 30-day automatic rotation; the NFM-2924
# 7-day green streak tracks those artifacts, not local re-runs.
#
# Env vars (override defaults by exporting in the cron user's shell or by
# editing the `PARITY_*` lines below):
#   PARITY_REPO_DIR    (default: /Users/lwj04/Projects/nucpot)
#   PARITY_PYTHON      (default: $PARITY_REPO_DIR/apps/api/.venv/bin/python)
#   PARITY_ARTIFACTS   (default: /var/log/nucpot/parity)
#   PARITY_RETENTION   (default: 30)
# =============================================================================
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PARITY_REPO_DIR=/Users/lwj04/Projects/nucpot
PARITY_PYTHON=/Users/lwj04/Projects/nucpot/apps/api/.venv/bin/python
PARITY_ARTIFACTS=/var/log/nucpot/parity
PARITY_RETENTION=30

# m h dom mon dow user command
0 2 * * * root /Users/lwj04/Projects/nucpot/scripts/run-parity-cron.sh >> /var/log/nucpot/parity/cron.log 2>&1