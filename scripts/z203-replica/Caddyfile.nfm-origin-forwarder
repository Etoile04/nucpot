# NFM origin forwarder — deployed to /etc/nfm/origin-forwarder/Caddyfile
# by scripts/z203-replica/install-replica.sh. Reviewed on NFM-5965 (D2-G2).
#
# Loopback-only listeners: the remotely-managed edge configs dial
# `localhost:3000` (MAIN tunnel 04b1e559) and `localhost:8002` (VERIFY tunnel
# 847668eb) on the replica host; caddy site addresses written as
# `http://localhost:PORT` bind BOTH 127.0.0.1 and ::1, so the origin dial
# succeeds regardless of address resolution order.
{
	admin off
	auto_https off
	log {
		output file /var/log/nfm-origin-forwarder/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		level INFO
	}
}

# MAIN tunnel origin — Mac prod web over Tailscale.
# Active healthcheck hits the real prod health endpoint; expected 200.
http://localhost:3000 {
	reverse_proxy 100.65.21.27:3000 {
		health_uri /api/v1/health
		health_port 3000
		health_interval 10s
		health_timeout 5s
		health_passes 2
		health_fails 3
		health_status 200
	}
}

# VERIFY tunnel origin — Mac verify origin (uvicorn) over Tailscale.
# This service has no /api/v1/health route; it answers 404 on every probe
# path by design (measured 2026-11-12 from the Mac vantage), so the active
# healthcheck pins the expected status at 404 — any other code (or a
# timeout) marks the upstream unhealthy.
http://localhost:8002 {
	reverse_proxy 100.65.21.27:8002 {
		health_uri /
		health_port 8002
		health_interval 30s
		health_timeout 5s
		health_passes 2
		health_fails 3
		health_status 404
	}
}
