{
  "name": "nfm-db",
  "private": true,
  "description": "Nuclear Fuel & Materials Properties Database Platform",
  "scripts": {
    "dev": "pnpm --filter @nfm-db/web dev",
    "dev:api": "cd apps/api && uvicorn nfm_db.main:app --reload --port 8000",
    "build": "pnpm --filter @nfm-db/web build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @nfm-db/web test:e2e"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "next": "16.2.11",
      "postcss": "8.5.23",
      "nanoid": "3.3.18",
      "js-yaml@4": "4.3.1",
      "js-yaml@3": "3.15.1",
      "brace-expansion@5": "5.0.9",
      "brace-expansion@1": "1.1.18",
      "sharp": "0.35.0",
      "echarts": "6.1.0"
    }
  }
}
