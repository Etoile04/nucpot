# =============================================================================
# LightRAG Sidecar — Runtime Defaults (NFM-3404 / NFM-3425)
# =============================================================================
# This file is the SINGLE source of truth for the RAG query timeout topology
# described in ADR-NFM-3404 §2.1. See .env.lightrag.example for the full
# operator-facing template (Postgres / LLM / embedding / RAG / auth blocks).
#
# Invariant — must always hold (with defaults: 8 + 3 + 1 = 12 <= 14 <= 15 ✓):
#   LIGHTRAG_LLM_TIMEOUT_S
#     + NFM_LIGHTRAG_QUERY_CONNECT_S
#     + 1_safety
#       <= NFM_LIGHTRAG_QUERY_TIMEOUT_S
#         <= NEXT_PUBLIC_RAG_QUERY_TIMEOUT_MS / 1000
#           <= 15
# =============================================================================

# ---- Sidecar (docker-compose.lightrag.yml -> LLM_TIMEOUT) ----------------
LIGHTRAG_LLM_TIMEOUT_S=8

# ---- Backend (apps/api/src/nfm_db/services/lightrag_client.py) -----------
NFM_LIGHTRAG_QUERY_CONNECT_S=3
NFM_LIGHTRAG_QUERY_TIMEOUT_S=12

# ---- Frontend (apps/web/src/lib/rag-api.ts → AbortController) -------------
NEXT_PUBLIC_RAG_QUERY_TIMEOUT_MS=14000
