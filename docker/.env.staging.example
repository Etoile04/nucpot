# =============================================================================
# NFM-DB — Staging environment template (NFM-111)
# =============================================================================
# Copy to docker/.env.staging and fill in real values BEFORE the first deploy:
#   cp docker/.env.staging.example docker/.env.staging
#   # edit docker/.env.staging
#   ./scripts/staging_deploy.sh deploy
#
# docker/.env.staging is git-ignored. NEVER commit real secrets.
# Consumed by docker-compose.staging.yml via scripts/staging_deploy.sh.
# Full reference: docs/deployment/staging-pipeline.md
# =============================================================================

# ---- Image tag (NFM-4066: derived at deploy time) ---------------------------
# NFM-4066: scripts/staging_deploy.sh now derives this value from
# ``git rev-parse HEAD`` at the start of every ``deploy`` invocation, so
# the tag name is always truthful and can never drift from what was
# actually built. Any value placed here is treated as a default / hint:
# the deploy script logs a warning when it overrides a non-empty value,
# and ``cmd_rollback`` still reads it for its existence check.
#
# Leaving the literal ``latest`` here is safe — the deploy script's
# SHA-derivation will overwrite it before docker compose runs. Keep this
# default for clarity; bump it ONLY if you want a specific tag to be the
# default rollback target (the deploy script will still override).
STAGING_IMAGE_TAG=latest

# ---- Host port mapping ------------------------------------------------------
# NFM-112 contract: staging API on 127.0.0.1:8001, web on 3000.
STAGING_API_HOST_PORT=8001
STAGING_WEB_HOST_PORT=3000
STAGING_DB_HOST_PORT=5432

# ---- Secrets (REQUIRED — generate strong values) ----------------------------
# Generate e.g.: openssl rand -hex 32
STAGING_API_SECRET_KEY=change-me-generate-a-strong-secret
# Generate e.g.: openssl rand -hex 24  (used by the bundled PG16 container)
STAGING_POSTGRES_PASSWORD=change-me-generate-a-strong-password

# ---- Bundled PostgreSQL 16 --------------------------------------------------
STAGING_POSTGRES_USER=nfm
STAGING_POSTGRES_DB=nfm_db
# Default DATABASE_URL points the API at the bundled PG16 container. The NFM-DB
# API uses asyncpg. alembic reads this same URL to run migrations on startup.
# The password interpolates STAGING_POSTGRES_PASSWORD (defined above), so the
# single generated value stays the source of truth — no need to paste it twice.
# staging_deploy.sh sources this file, so ${STAGING_POSTGRES_PASSWORD} expands
# before docker compose runs.
STAGING_DATABASE_URL=postgresql+asyncpg://nfm:${STAGING_POSTGRES_PASSWORD}@nucpot-staging-db:5432/nfm_db

# ---- CORS / public origins --------------------------------------------------
# JSON array (pydantic-settings parses lists as JSON). Use the staging web origin.
STAGING_CORS_ORIGINS=["https://staging.nucpot.dpdns.org"]

# ---- Cloudflare Tunnel (public ingress) -------------------------------------
# REQUIRED (NFM-112 acceptance). Token for the remotely-managed staging tunnel
# from Cloudflare Zero Trust -> Networks -> Tunnels -> <tunnel> -> Install.
# Drives the `cloudflared` service in docker-compose.staging.yml. The dashboard
# ingress (staging.nucpot.dpdns.org -> web:3000, staging-api.nucpot.dpdns.org
# -> api:8000) is configured in the Cloudflare UI, not here.
STAGING_CLOUDFLARE_TUNNEL_TOKEN=change-me-paste-token-from-cloudflare-zero-trust
# Host port (localhost-only) for the cloudflared metrics server. Monitor tunnel
# readiness with: curl -fsS http://127.0.0.1:36500/ready
STAGING_CLOUDFLARED_METRICS_HOST_PORT=36500

# ---- Misc -------------------------------------------------------------------
STAGING_DEBUG=false
STAGING_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Health gate (deploy script) --------------------------------------------
STAGING_HEALTH_PATH=/api/v1/health
STAGING_HEALTH_TIMEOUT=120
STAGING_ROLLBACK_TAG=prev

# ---- LightRAG sidecar (knowledge-graph RAG, NFM-1221) -----------------------
STAGING_LIGHTRAG_HOST_PORT=9621
STAGING_LIGHTRAG_LLM_BINDING=openai
STAGING_LIGHTRAG_LLM_MODEL=gpt-4o-mini
STAGING_LIGHTRAG_LLM_HOST=https://api.openai.com/v1
STAGING_LIGHTRAG_LLM_API_KEY=change-me-paste-openai-api-key
STAGING_LIGHTRAG_EMBEDDING_BINDING=openai
STAGING_LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
STAGING_LIGHTRAG_EMBEDDING_HOST=https://api.openai.com/v1
STAGING_LIGHTRAG_EMBEDDING_API_KEY=change-me-paste-openai-api-key

# ---- NFM-4170 / NFM-4162 — canonical data_sources.id UUIDs ------------------
# Comma-separated list of the 6 canonical ``data_sources.id`` rows that
# absorbed the migration 070 collapse (NFM-4130).  Consumed by
# ``attribution_flag.py`` (NFM-4159, PR #1113) at module load.
# ``scripts/staging_deploy.sh`` forwards this into the api container's
# ``docker/.env.staging.api`` as ``NFM_ATTRIBUTION_LOST_CANONICAL_DATA_SOURCE_IDS``.
# Empty default = safe no-op (§5.1 filter returns all rows as ``intact``).
# Canonical-id order (NFM-4162 PUBLISHED, comment 6a1392c2-…).
STAGING_NFM_ATTRIBUTION_LOST_CANONICAL_DATA_SOURCE_IDS=1a0f45d9-b4a4-45f2-a073-9d5779139e9c,49034bf0-f58e-4900-889d-11342c77c518,673258f9-21dc-4485-a6dd-1eb1df13ed23,9320cb50-eb65-4178-8d2e-c56aeb848b21,a4c37a11-13da-4316-8025-7adb1b9c5651,cd36999a-b0a0-4d76-935f-6595bb09cb64

# ---- NFM-4197 — preview-role password (migration 073) ------------------------
# ``NFMD_PREVIEW_DB_PASSWORD`` is read by migration 073_create_nfm_preview_role,
# which the staging api container runs on boot (``alembic upgrade head``).
# REQUIRED whenever a fresh staging DB (volume rebuild) upgrades THROUGH 073;
# DBs already at >= 073 ignore it — leave it set regardless so the next
# rebuild never hits the boot crash-loop (NFM-4190 workaround). Staging may
# use a password INDEPENDENT from prod (rotate separately). Generate e.g.:
# openssl rand -hex 24. ``scripts/staging_deploy.sh`` forwards it verbatim
# into the api container's ``docker/.env.staging.api``; the migration itself
# raises a loud RuntimeError when it needs the var and finds it empty.
NFMD_PREVIEW_DB_PASSWORD=change-me-generate-a-strong-preview-password
# ---- NFM-4207 — DATA_LOSS_NOTICE frontend feature flag (spec §6.1) ---------
# Baked into the web client bundle at BUILD time (web.Dockerfile ARG
# NEXT_PUBLIC_DATA_LOSS_NOTICE, inlined by `next build`). Changing it
# requires a redeploy (`staging_deploy.sh deploy` rebuilds); a container
# restart alone does NOT flip the flag. Staging ships ON (spec §6.1) so the
# data-loss notice is canary-visible; set to `off` to suppress.
STAGING_DATA_LOSS_NOTICE=on
