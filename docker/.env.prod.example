# Production environment variables for NFM-DB
# Copy to docker/.env.prod and fill in real values

# PostgreSQL
PROD_POSTGRES_USER=nfm
PROD_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PROD_POSTGRES_DB=nfm_db
PROD_DB_HOST_PORT=5433

# NFM-4122: password for the least-privilege `nfm_preview` role used by
# preview/QA containers that point at nucpot-prod-db. MUST be distinct
# from PROD_POSTGRES_PASSWORD. The role has DML on the public schema but
# no DDL and no write on alembic_version, so a bare
# `docker exec nucpot-prod-api-preview alembic upgrade head` fails
# before it can stamp. Sourced from the secret manager alongside
# PROD_POSTGRES_PASSWORD; rotate by ALTER ROLE … WITH PASSWORD (see
# docs/runbooks/prod-deploy.md §6.5).
NFMD_PREVIEW_DB_PASSWORD=CHANGE_ME_DISTINCT_FROM_PROD_POSTGRES_PASSWORD

# API
PROD_API_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
PROD_API_HOST_PORT=8001
PROD_CORS_ORIGINS=["https://nucpot.dpdns.org"]
PROD_ACCESS_TOKEN_EXPIRE_MINUTES=30
PROD_IMAGE_TAG=latest

# Worker
PROD_WORKER_CONCURRENCY=1

# Web (Next.js frontend)
PROD_WEB_HOST_PORT=3000

# HPC (Guangzhou Supercomputing)
NFM_HPC_PRIMARY_HOST=
NFM_HPC_PRIMARY_USER=

# Redis
PROD_REDIS_HOST_PORT=6380

# LightRAG sidecar (NFM-1221) — knowledge graph RAG service
PROD_LIGHTRAG_HOST_PORT=9621
PROD_LIGHTRAG_LLM_BINDING=openai
PROD_LIGHTRAG_LLM_MODEL=gpt-4o-mini
PROD_LIGHTRAG_LLM_HOST=https://api.openai.com/v1
PROD_LIGHTRAG_LLM_API_KEY=CHANGE_ME_OPENAI_KEY
PROD_LIGHTRAG_EMBEDDING_BINDING=openai
PROD_LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
PROD_LIGHTRAG_EMBEDDING_HOST=https://api.openai.com/v1
PROD_LIGHTRAG_EMBEDDING_API_KEY=CHANGE_ME_OPENAI_KEY

# VLM (vision-language) for figure/table extraction — NFM-3358
# Default provider is minimax; override to ``ollama`` to use the local
# vision model, or ``openai`` for hosted OpenAI-compatible APIs.
PROD_VLM_PROVIDER=minimax
PROD_VLM_BASE_URL=https://api.minimaxi.com/v1
PROD_VLM_MODEL=MiniMax-M3
# Insert the MiniMax API key here (or set via your secret manager).
PROD_VLM_API_KEY=

# Paperclip board-actor credentials (NFM-3727)
# Required for ADR-009 §4.3-b daily reconcile cron to wake assignee agents.
# PAPERCLIP_BOARD_API_KEY must be a board-actor API key (name=lobster-coo) —
# the agent-self JWT (PAPERCLIP_API_KEY) returns 403 for cross-agent wakeup.
# PAPERCLIP_API_URL points to the Paperclip API reachable from inside
# the Docker network.
PAPERCLIP_BOARD_API_KEY=CHANGE_ME_BOARD_ACTOR_KEY
PAPERCLIP_API_KEY=
PAPERCLIP_API_URL=http://paperclip-api:3101

# --- Supabase (server-side admin client for web BFF routes) ---
# Required by /api/admin/ref-values/* — when unset, supabaseAdmin is null and
# admin routes return HTTP 500. Copy the value from ~/Projects/nucpot/.env.local
SUPABASE_SERVICE_ROLE_KEY=

# --- NFM-4170 / NFM-4162 — canonical data_sources.id UUIDs ---
# Comma-separated list of the 6 canonical ``data_sources.id`` rows that
# absorbed the migration 070 collapse (NFM-4130).  Consumed by
# ``apps.api.src.nfm_db.services.attribution_flag`` at module load
# (consumer landed on NFM-4159, PR #1113; config ships ahead of consumer
# so deploys land with the populated list immediately).
#
# Empty default = safe no-op (§5.1 filter returns all rows as
# ``intact``); populated value = surface
# ``attribution.status: "lost"`` on measurements whose ``source_id``
# matches one of these canonicals.  Canonical-id order (matches
# NFM-4162 PUBLISHED table, comment 6a1392c2-…).
NFM_ATTRIBUTION_LOST_CANONICAL_DATA_SOURCE_IDS=1a0f45d9-b4a4-45f2-a073-9d5779139e9c,49034bf0-f58e-4900-889d-11342c77c518,673258f9-21dc-4485-a6dd-1eb1df13ed23,9320cb50-eb65-4178-8d2e-c56aeb848b21,a4c37a11-13da-4316-8025-7adb1b9c5651,cd36999a-b0a0-4d76-935f-6595bb09cb64
