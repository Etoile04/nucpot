<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nucpot.docker-raw-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/usr/local/bin/docker-raw-guard.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/dev/null</string>

    <key>StandardErrorPath</key>
    <string>/dev/null</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!--
            launchd does NOT expand $HOME (or any shell syntax) inside
            EnvironmentVariables. Setting LOG_FILE to "$HOME/..." here would
            pass the literal string through and break every scheduled run under
            set -euo pipefail. The script's own default (`$HOME/Library/Logs/
            docker-raw-guard.log`) is bash parameter expansion, which DOES
            resolve at script execution time. Override LOG_FILE with an
            ABSOLUTE PATH in this dict if you need a non-default location.
        -->
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
