# Nucpot production environment variables
# Copy to .env.prod and fill in real values.
#
# Paperclip API
PAPERCLIP_API_URL=http://paperclip-api:3101

# Board-actor API key for cross-agent wakeup (ADR-009 section 4.3-b).
# Required for the daily reconcile cron to wake assignees.
# Provision via Paperclip admin settings or company API keys.
PAPERCLIP_BOARD_API_KEY=

# Per-run Hermes JWT (injected automatically by Hermes).
# Falls back to this if PAPERCLIP_BOARD_API_KEY is not set.
# NOTE: agent-self scoped -- will NOT work for wake (returns 403).
PAPERCLIP_API_KEY=

# NFM-4170 / NFM-4162 — comma-separated UUIDs of the canonical
# ``data_sources.id`` rows that absorbed the migration 070 collapse
# (NFM-4130).  Consumed by ``attribution_flag.py`` (NFM-4159, PR #1113)
# at module load.  Empty default = safe no-op (§5.1 filter returns all
# rows as ``intact``); populated value = surface
# ``attribution.status: "lost"`` on measurements whose ``source_id``
# points at one of these canonicals.
#
# Canonical-id order (matches NFM-4162 PUBLISHED table, comment 6a1392c2-…):
NFM_ATTRIBUTION_LOST_CANONICAL_DATA_SOURCE_IDS=1a0f45d9-b4a4-45f2-a073-9d5779139e9c,49034bf0-f58e-4900-889d-11342c77c518,673258f9-21dc-4485-a6dd-1eb1df13ed23,9320cb50-eb65-4178-8d2e-c56aeb848b21,a4c37a11-13da-4316-8025-7adb1b9c5651,cd36999a-b0a0-4d76-935f-6595bb09cb64
